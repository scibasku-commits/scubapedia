---
import { getCollection } from 'astro:content';
import { normalizeZona, zonaSlug, zonaRank, zonaBlurb, zonaGradient } from '../lib/zonas';
import { etiquetaCorta } from '../lib/ficha-datos';
import { destinoImage, slugImage } from '../lib/imagen';
import ChatWidget from '../components/ChatWidget.astro';
import CaptacionForm from '../components/CaptacionForm.astro';
import '../styles/global.css';

const all = await getCollection('buceo');
const idOf = (e: any) => e.id.replace(/\.md$/, '');

// ---- agrupación por ZONA ----
const byZona = new Map<string, typeof all>();
for (const e of all) {
  const z = normalizeZona(e.data.region || '');
  if (!byZona.has(z)) byZona.set(z, [] as any);
  (byZona.get(z) as any).push(e);
}
const zonas = [...byZona.keys()].sort((a, b) => {
  const ra = zonaRank(a), rb = zonaRank(b);
  return ra !== rb ? ra - rb : a.localeCompare(b);
});
const zonaBlocks = zonas.map((z) => ({
  zona: z,
  slug: zonaSlug(z),
  blurb: zonaBlurb(z),
  destinos: (byZona.get(z) as any)
    .slice()
    .sort((a: any, b: any) => a.data.title.localeCompare(b.data.title))
    .map((e: any) => ({
      title: e.data.title,
      url: `/destinos/${idOf(e)}`,
      cert: etiquetaCorta(e.data.certificacion_minima) ?? '',
      giora: !!e.data.giora_estuvo,
    })),
}));
// dos columnas equilibradas por nº de destinos
const colA: typeof zonaBlocks = [], colB: typeof zonaBlocks = [];
let nA = 0, nB = 0;
for (const blk of zonaBlocks) {
  if (nA <= nB) { colA.push(blk); nA += blk.destinos.length + 2; }
  else { colB.push(blk); nB += blk.destinos.length + 2; }
}

const byId = new Map(all.map((e) => [idOf(e), e]));

// ---- 6 destacadas curadas (variedad geográfica; nota editorial real) ----
const DESTACADAS_SEED = [
  { id: 'raja-ampat',           idx: '01', note: 'El epicentro de la biodiversidad marina: 1.700 especies de peces sobre 1.500 islas kársticas.' },
  { id: 'brother-islands',      idx: '02', note: 'Dos montañas submarinas en pleno Mar Rojo: pecios, paredes verticales y tiburones oceánicos.' },
  { id: 'maldivas-baa-hanifaru', idx: '03', note: 'Hanifaru Bay: cientos de mantas alimentándose a la vez. Reserva de la Biosfera UNESCO.' },
  { id: 'galapagos',            idx: '04', note: 'Martillos en cardumen, tiburón ballena e iguanas marinas. Corrientes que lo deciden todo.' },
  { id: 'palau',                idx: '05', note: 'Blue Corner y el Jellyfish Lake: el Pacífico en su versión más salvaje y vertical.' },
  { id: 'cozumel',              idx: '06', note: 'Deriva sobre arrecife caribeño, agua tibia y visibilidad de postal. El clásico para volar.' },
];
const destacadas = DESTACADAS_SEED.map((d) => {
  const e = byId.get(d.id);
  if (!e) return null;
  const z = normalizeZona(e.data.region || '');
  const reg = (e.data.region || '').split(',')[0].trim();
  return {
    ...d,
    title: e.data.title.split(' - ')[0].split(' — ')[0].trim(),
    url: `/destinos/${d.id}`,
    region: reg || e.data.pais || '',
    pais: e.data.pais || '',
    cert: etiquetaCorta(e.data.certificacion_minima) ?? '',
    giora: !!e.data.giora_estuvo,
    grad: zonaGradient(z),
    img: destinoImage(d.id, 'card'),
  };
}).filter((d): d is NonNullable<typeof d> => Boolean(d));

// ---- índice de búsqueda (todas las fichas) ----
const searchIdx = all.map((e) => ({
  t: e.data.title.trim(),
  u: `/destinos/${idOf(e)}`,
  c: normalizeZona(e.data.region || ''),
  m: etiquetaCorta(e.data.certificacion_minima) ?? '',
})).sort((a, b) => a.t.localeCompare(b.t));

// ---- glosario de buceo ----
const GLOSARIO = [
  { term: 'Visibilidad', en: 'viz', pos: 's. f.', def: 'Distancia horizontal a la que se distingue un objeto bajo el agua. La fija el plancton, la corriente y el fondo; condiciona toda la inmersión.' },
  { term: 'Deriva', en: 'drift', pos: 's. f.', def: 'Inmersión dejándose llevar por la corriente, sin nadar contra ella. El barco recoge al grupo donde emerge. Exige control de flotabilidad.' },
  { term: 'Liveaboard', en: 'barco-vida', pos: 's. m.', def: 'Crucero de buceo de varios días: se come, se duerme y se bucea a bordo. Da acceso a arrecifes remotos imposibles desde tierra.' },
  { term: 'Pelágico', en: 'pelagic', pos: 'adj.', def: 'Especie de mar abierto, lejos del fondo y la costa: mantas, tiburones, atunes, ballenas. El gran reclamo de los destinos oceánicos.' },
  { term: 'Parada de seguridad', en: 'safety stop', pos: 'loc.', def: 'Tres minutos a unos cinco metros antes de salir, para liberar el nitrógeno acumulado. Rutina innegociable de todo ascenso.' },
  { term: 'Nitrox', en: 'EANx', pos: 's. m.', def: 'Aire enriquecido con más oxígeno y menos nitrógeno. Alarga el tiempo de fondo y reduce la fatiga; requiere certificación específica.' },
];

const totalFichas = all.length;
const totalZonas = zonas.length;
const gioraEstuvo = all.filter((e) => e.data.giora_estuvo).length;

const title = 'Scubapedia — Enciclopedia editorial de destinos de buceo en castellano';
const description = `Enciclopedia editorial de ${totalFichas} destinos de buceo en castellano. Profundidad, visibilidad, fauna, mejor época y nivel — datos verificables, sin marketing vacío.`;
const canonical = new URL('/', Astro.site ?? 'https://www.scubapedia.org').toString();
const ogImage = new URL('/og-default.png', Astro.site ?? 'https://www.scubapedia.org').toString();
// Un solo sitio del que sale el dominio, para que canonical, og:url y el JSON-LD
// no puedan discrepar como discrepaban.
const SITE_URL = (Astro.site ?? new URL('https://www.scubapedia.org')).toString().replace(/\/$/, '');
const CRUCERO = 'https://crucerobuceo.com';
const WA = 'https://wa.me/34619401041';
const heroPhoto = slugImage('mar-rojo', 'hero'); // foto real de arrecife para el masthead
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="Scubapedia" />
  <meta property="og:locale" content="es_ES" />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,500;1,9..144,600&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400;1,9..40,500&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'WebSite', '@id': `${SITE_URL}/#website`, name: 'Scubapedia',
        url: SITE_URL, description,
        publisher: { '@id': `${SITE_URL}/#viajes-scibasku` },
      },
      {
        '@type': 'TravelAgency', '@id': `${SITE_URL}/#viajes-scibasku`,
        name: 'Viajes Scibasku', url: 'https://viajesscibasku.com',
        identifier: { '@type': 'PropertyValue', propertyID: 'CICMA', value: '2283' },
      },
      {
        '@type': 'ItemList', '@id': `${SITE_URL}/#catalogo`,
        name: `Catálogo de ${totalFichas} destinos de buceo`,
        numberOfItems: totalFichas,
        itemListElement: searchIdx.map((d, i) => ({
          '@type': 'ListItem', position: i + 1, name: d.t,
          url: new URL(d.u, SITE_URL).toString(),
        })),
      },
    ],
  }).replace(/</g, '\\u003c')} />
  <!-- Google Analytics (GA4) -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-LHZYGMPX6K"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-LHZYGMPX6K');
  </script>

  <style is:global>
    :root{
      --paper:#f1ebdd; --paper-2:#e9e1cf; --paper-card:#faf6ec;
      --ink:#1b211f; --ink-2:#30383a; --ink-muted:#647072;
      --rule:#1b211f22; --rule-strong:#1b211f55;
      --accent:#0A5570; --accent-ink:#073f54; --accent-decor:#16A6C9; --accent-soft:#16A6C91f;
      --deep:#06283a; --maxw:1200px;
      --font-display:'Fraunces',Georgia,serif;
      --font-body:'DM Sans',system-ui,-apple-system,sans-serif;
    }
    *{box-sizing:border-box;margin:0;padding:0}
    html{scroll-behavior:smooth;background:var(--paper)}
    body{background:var(--paper);color:var(--ink);font-family:var(--font-body);font-weight:400;font-size:18px;line-height:1.6;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;overflow-x:hidden}
    .wrap{max-width:var(--maxw);margin:0 auto;padding:0 36px}
    a{color:inherit;text-decoration:none}
    img{display:block;max-width:100%}
    ::selection{background:var(--accent);color:#f4eee1}
    .eyebrow{font-family:var(--font-body);font-size:12px;font-weight:500;letter-spacing:.26em;text-transform:uppercase;color:var(--ink-muted)}

    /* top nav */
    .nav{position:fixed;top:0;left:0;right:0;z-index:60;transition:background .4s ease, box-shadow .4s ease, color .4s ease;color:#eaf6f9}
    .nav-inner{max-width:var(--maxw);margin:0 auto;padding:16px 36px;display:flex;align-items:center;justify-content:space-between}
    .nav-mark{display:flex;align-items:center;line-height:0}
    .nav-mark img{height:48px;width:auto;display:block}
    .nav:not(.solid) .nav-mark img{filter:brightness(0) invert(1) drop-shadow(0 2px 10px rgba(4,20,30,.5))}
    .nav-links{display:flex;gap:30px;align-items:center}
    .nav-links a,.nav-links button{font-size:14px;letter-spacing:.04em;opacity:.88;position:relative;padding:4px 0;transition:opacity .2s;background:none;border:0;color:inherit;font-family:var(--font-body);cursor:pointer}
    .nav-links a:hover,.nav-links button:hover{opacity:1}
    .nav-links a::after,.nav-links .nav-link::after{content:"";position:absolute;left:0;right:100%;bottom:0;height:1px;background:currentColor;transition:right .28s ease}
    .nav-links a:hover::after,.nav-links .nav-link:hover::after{right:0}
    .nav-cta{border:1px solid currentColor;border-radius:999px;padding:7px 16px !important;opacity:1 !important;letter-spacing:.02em}
    .nav-cta::after{display:none}
    .nav-cta:hover{background:#eaf6f9;color:var(--deep)}
    .nav.solid{background:rgba(241,235,221,.93);backdrop-filter:saturate(120%) blur(8px);color:var(--ink);box-shadow:0 1px 0 var(--rule)}
    .nav.solid .nav-cta:hover{background:var(--accent);color:#f4eee1;border-color:var(--accent)}
    .nav-toggle{display:none}

    /* hero — fondo de profundidad (sin foto en FASE 1) */
    .hero{position:relative;min-height:100svh;display:flex;flex-direction:column;color:#eaf6f9;overflow:hidden;background:#06283a}
    .hero-bg{position:absolute;inset:0;z-index:0;background:
      radial-gradient(120% 80% at 50% -10%, rgba(70,190,220,.30) 0%, rgba(70,190,220,0) 55%),
      radial-gradient(90% 70% at 80% 10%, rgba(34,150,180,.22) 0%, rgba(34,150,180,0) 60%),
      linear-gradient(180deg,#0c6884 0%,#0a4a63 40%,#072e44 72%,#04212f 100%)}
    .hero-photo{position:absolute;inset:0;z-index:0;width:100%;height:100%;object-fit:cover;object-position:center 58%}
    .hero-scrim{position:absolute;inset:0;z-index:0;background:linear-gradient(180deg,rgba(4,28,42,.62) 0%,rgba(4,28,42,.40) 38%,rgba(4,28,42,.52) 68%,rgba(3,20,30,.82) 100%)}
    /* rayos de luz */
    .hero-rays{position:absolute;inset:0;z-index:1;pointer-events:none;opacity:.5;mix-blend-mode:screen;
      background:repeating-linear-gradient(101deg, rgba(180,235,250,.07) 0 2px, transparent 2px 46px)}
    .hero-grain{position:absolute;inset:0;z-index:1;opacity:.4;mix-blend-mode:overlay;background-image:repeating-linear-gradient(0deg, #ffffff10 0 1px, transparent 1px 3px);pointer-events:none}
    .hero-wave{position:absolute;left:0;right:0;bottom:-2px;z-index:1;opacity:.22;pointer-events:none}
    .hero-wave svg{width:140%;margin-left:-20%;height:auto;display:block}
    .hero-inner{position:relative;z-index:2;flex:1;max-width:var(--maxw);width:100%;margin:0 auto;padding:0 36px;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;padding-top:120px;padding-bottom:56px}
    .masthead-rule{display:flex;align-items:center;gap:20px;width:min(640px,86vw);margin-bottom:26px}
    .masthead-rule .line{flex:1;height:1px;background:#eaf6f9aa}
    .masthead-rule .label{font-size:11.5px;letter-spacing:.28em;text-transform:uppercase;white-space:nowrap;color:#eaf6f9cc}
    .wordmark{line-height:0}
    .wordmark img{width:min(620px,84vw);height:auto;display:block;margin:0 auto;filter:brightness(0) invert(1) drop-shadow(0 8px 34px rgba(4,18,28,.55))}
    .slogan{margin-top:24px;max-width:760px;font-size:clamp(17px,2.1vw,23px);line-height:1.5;color:#eaf6f9;font-weight:400}
    .slogan b{font-weight:500}
    .slogan .dot{color:#eaf6f999;padding:0 .4em}

    /* search */
    .search{margin-top:40px;width:min(720px,92vw);position:relative;text-align:left}
    .search-box{display:flex;align-items:center;gap:14px;background:#faf6ecf2;border:1px solid #faf6ec;border-radius:4px;padding:0 18px;height:66px;box-shadow:0 24px 60px -28px rgba(4,18,28,.7);transition:box-shadow .25s, transform .25s}
    .search-box:focus-within{box-shadow:0 30px 70px -26px rgba(4,18,28,.78);transform:translateY(-1px)}
    .search-ico{width:22px;height:22px;flex:none;color:var(--accent-decor)}
    .search input{flex:1;border:0;background:transparent;outline:0;font-family:var(--font-body);font-size:19px;color:var(--ink)}
    .search input::placeholder{color:#647072;font-style:italic;opacity:.9}
    .search-kbd{font-size:11px;letter-spacing:.12em;color:#647072;border:1px solid var(--rule-strong);border-radius:4px;padding:4px 8px;white-space:nowrap}
    .search-sub{margin-top:12px;display:flex;gap:18px;flex-wrap:wrap;color:#eaf6f9cc;font-size:13.5px;letter-spacing:.02em}
    .search-sub span{display:inline-flex;align-items:center;gap:8px}
    .search-sub .pip{width:5px;height:5px;border-radius:50%;background:#eaf6f9aa}
    .suggest{position:absolute;left:0;right:0;top:74px;z-index:30;background:var(--paper-card);border:1px solid var(--rule);border-radius:4px;box-shadow:0 30px 70px -30px rgba(4,18,28,.6);overflow:hidden;max-height:340px;overflow-y:auto;display:none}
    .suggest.open{display:block}
    .suggest .sg-head{padding:11px 18px;font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--ink-muted);border-bottom:1px solid var(--rule)}
    .sg-item{display:flex;align-items:baseline;justify-content:space-between;gap:16px;padding:12px 18px;cursor:pointer;border-bottom:1px solid var(--rule);color:var(--ink)}
    .sg-item:last-child{border-bottom:0}
    .sg-item:hover,.sg-item.active{background:#efe6d2}
    .sg-name{font-family:var(--font-display);font-size:18px;color:var(--ink)}
    .sg-name b{color:var(--accent);font-style:normal}
    .sg-meta{font-size:13px;color:var(--ink-muted);white-space:nowrap}
    .sg-empty{padding:18px;color:var(--ink-muted);font-style:italic}

    .hero-foot{position:relative;z-index:2;max-width:var(--maxw);width:100%;margin:0 auto;padding:0 36px 26px;display:flex;justify-content:space-between;align-items:flex-end;gap:20px;color:#eaf6f9cc;font-size:12.5px;letter-spacing:.04em}
    .hero-foot .scrollhint{display:inline-flex;align-items:center;gap:10px}
    .hero-foot .scrollhint .v{display:inline-block;animation:bob 2s ease-in-out infinite}
    @keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(4px)}}

    /* section scaffolding */
    section{position:relative}
    .band{padding:104px 0}
    .band.alt{background:var(--paper-2)}
    .sec-head{display:flex;justify-content:space-between;align-items:flex-end;gap:30px;margin-bottom:46px}
    .sec-head .h-l{max-width:680px}
    .sec-title{font-family:var(--font-display);font-weight:600;font-size:clamp(34px,4.6vw,56px);line-height:1.02;letter-spacing:-.01em;margin-top:14px;color:var(--ink)}
    .standfirst{margin-top:16px;font-size:19px;color:var(--ink-2);max-width:560px;text-wrap:pretty}
    .more-link{font-size:15px;letter-spacing:.02em;white-space:nowrap;border-bottom:1px solid var(--rule-strong);padding-bottom:3px;transition:border-color .2s,color .2s;color:var(--ink)}
    .more-link:hover{color:var(--accent);border-color:var(--accent)}
    .topline{height:1px;background:var(--rule-strong);margin-bottom:0}

    /* destacadas */
    .cards{display:grid;grid-template-columns:repeat(3,1fr);gap:2px;background:var(--rule);border:1px solid var(--rule)}
    .card{background:var(--paper);padding:26px 26px 30px;display:flex;flex-direction:column;transition:background .3s}
    .card:hover{background:var(--paper-card)}
    .card-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px}
    .card-idx{font-family:var(--font-body);font-size:13px;letter-spacing:.18em;color:var(--ink-muted)}
    .card-region{font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--accent)}
    .card-figure{position:relative;aspect-ratio:4/3;overflow:hidden;border:1px solid var(--rule);margin-bottom:20px;display:flex;align-items:flex-end;justify-content:flex-start}
    .card-figure .fg-grad{position:absolute;inset:0;transition:transform .9s cubic-bezier(.2,.7,.2,1)}
    .card:hover .card-figure .fg-grad{transform:scale(1.05)}
    .card-figure .fg-wave{position:absolute;left:0;right:0;bottom:-1px;opacity:.5}
    .card-figure .fg-wave svg{width:130%;margin-left:-15%;height:auto;display:block}
    .card-figure .fg-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .9s cubic-bezier(.2,.7,.2,1)}
    .card:hover .card-figure .fg-img{transform:scale(1.05)}
    .card-figure::after{content:"";position:absolute;inset:0;background:linear-gradient(to top,rgba(4,18,28,.55),transparent 52%);z-index:1}
    .card-figure .fg-z{position:relative;z-index:2;margin:12px 14px;font-family:var(--font-display);font-style:italic;font-size:16px;color:#eaf6f9;letter-spacing:.02em;text-shadow:0 2px 14px rgba(0,0,0,.4)}
    .card-figure .fg-giora{position:absolute;z-index:2;top:12px;right:12px;font-size:11px;letter-spacing:.08em;text-transform:uppercase;background:rgba(255,255,255,.9);color:var(--accent-ink);padding:5px 9px;border-radius:999px;font-weight:600}
    .card-name{font-family:var(--font-display);font-weight:600;font-size:26px;line-height:1.08;letter-spacing:-.01em}
    .card-name a{color:var(--ink);background-image:linear-gradient(var(--accent),var(--accent));background-size:0% 1px;background-repeat:no-repeat;background-position:0 100%;transition:background-size .3s;padding-bottom:2px}
    .card:hover .card-name a{background-size:100% 1px}
    .card-note{margin-top:9px;color:var(--ink-muted);font-size:15.5px;font-style:italic;line-height:1.45;flex:1}
    .card-meta{margin-top:18px;padding-top:14px;border-top:1px solid var(--rule);display:flex;align-items:baseline;justify-content:space-between}
    .card-country{font-size:14px;letter-spacing:.04em;color:var(--ink-2)}
    .card-cert{font-family:var(--font-display);font-size:16px;color:var(--accent)}

    /* directorio por zonas */
    .regions{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:0 64px;border-top:1px solid var(--rule-strong)}
    .region-col{padding:34px 0}
    .region-col:first-child{border-right:1px solid var(--rule);padding-right:48px}
    .region-col:last-child{padding-left:48px}
    .zona-blk{margin-bottom:30px}
    .zona-h{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:4px}
    .zona-h h3{font-family:var(--font-display);font-weight:600;font-size:26px;color:var(--ink)}
    .zona-h .tot{font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-muted)}
    .zona-h .tot b{font-family:var(--font-display);font-size:16px;color:var(--accent);font-style:italic}
    .zona-sub{font-size:14.5px;color:var(--ink-muted);font-style:italic;margin-bottom:10px;text-wrap:pretty}
    .idx-row{display:flex;align-items:baseline;gap:10px;padding:11px 6px;cursor:pointer;transition:background .2s,padding-left .25s;border-bottom:1px solid var(--rule);color:var(--ink)}
    .idx-row:hover{background:#00000008;padding-left:13px}
    .idx-name{font-family:var(--font-display);font-size:18px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0}
    .idx-giora{color:#0e6b82;font-style:normal;margin-left:6px;font-size:13px}
    .idx-lead{flex:1;border-bottom:1px dotted var(--rule-strong);transform:translateY(-4px)}
    .idx-cert{font-size:13px;color:var(--ink-2);white-space:nowrap}
    .idx-arrow{color:var(--accent);opacity:0;transform:translateX(-6px);transition:.25s;font-size:14px}
    .idx-row:hover .idx-arrow{opacity:1;transform:translateX(0)}

    /* glosario */
    .glossary{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:0 64px;border-top:1px solid var(--rule-strong)}
    .entry{padding:26px 0;border-bottom:1px solid var(--rule);display:grid;grid-template-columns:auto 1fr;gap:20px}
    .entry .term{font-family:var(--font-display);font-size:24px;line-height:1.1;color:var(--ink)}
    .entry .term .pos{display:block;font-family:var(--font-body);font-style:italic;font-size:14px;color:var(--ink-muted);font-weight:400;margin-top:3px}
    .entry .term .en{font-size:14px;color:var(--accent);font-style:italic;font-family:var(--font-body);font-weight:400;margin-left:.5em}
    .entry .def{font-size:16.5px;color:var(--ink-2);line-height:1.55;text-wrap:pretty}

    /* asistente */
    .giora-band{background:var(--accent);color:#eef6f9}
    .giora-grid{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center}
    .giora-eyebrow{color:#b6d6e2;letter-spacing:.26em}
    .giora-title{font-family:var(--font-display);font-weight:600;font-size:clamp(34px,4.4vw,52px);line-height:1.04;margin-top:14px;color:#eef6f9}
    .giora-title i{color:#fff}
    .giora-copy{margin-top:20px;font-size:18.5px;color:#d4e6ee;line-height:1.6;max-width:480px;text-wrap:pretty}
    .giora-feat{margin-top:26px;display:flex;flex-direction:column;gap:2px;border-top:1px solid #ffffff2e}
    .giora-feat .gf{display:flex;gap:14px;padding:14px 0;border-bottom:1px solid #ffffff2e;font-size:15.5px;color:#c7dde6}
    .giora-feat .gf b{font-family:var(--font-display);font-weight:500;color:#fff;font-size:16px;min-width:120px}
    .giora-cta{margin-top:30px;display:inline-flex;align-items:center;gap:12px;background:#faf6ec;color:var(--accent-ink);font-family:var(--font-body);font-size:16px;padding:14px 26px;border-radius:3px;cursor:pointer;border:1px solid #faf6ec;transition:transform .2s,background .2s}
    .giora-cta:hover{transform:translateY(-2px);background:#fff}
    .giora-cta .star{font-size:14px}
    .chat-card{background:#faf6ec;color:var(--ink);border-radius:6px;overflow:hidden;box-shadow:0 40px 90px -40px rgba(0,0,0,.6);border:1px solid #00000022}
    .chat-head{display:flex;align-items:center;gap:12px;padding:16px 20px;border-bottom:1px solid var(--rule);background:var(--paper-card)}
    .chat-ava{width:38px;height:38px;border-radius:50%;background:var(--accent);color:#fff;display:flex;align-items:center;justify-content:center;font-family:var(--font-display);font-style:italic;font-size:19px;flex:none}
    .chat-id{display:flex;flex-direction:column}
    .chat-id b{font-family:var(--font-display);font-weight:600;font-size:17px}
    .chat-id span{font-size:12px;color:var(--ink-muted);letter-spacing:.04em}
    .chat-status{margin-left:auto;display:inline-flex;align-items:center;gap:7px;font-size:12px;color:var(--ink-muted)}
    .chat-status .d{width:7px;height:7px;border-radius:50%;background:#3f8a52}
    .chat-body{padding:20px;display:flex;flex-direction:column;gap:14px;max-height:330px;overflow-y:auto}
    .msg{max-width:84%;font-size:15.5px;line-height:1.5}
    .msg.u{align-self:flex-end;background:var(--accent);color:#f1f4f8;padding:11px 15px;border-radius:14px 14px 4px 14px}
    .msg.g{align-self:flex-start;color:var(--ink-2)}
    .msg.g .gtag{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--accent);margin-bottom:6px}
    .msg.g .gbody{background:#fff;border:1px solid var(--rule);padding:13px 16px;border-radius:4px 14px 14px 14px}
    .msg.g .cite{margin-top:9px;font-size:12.5px;color:var(--ink-muted);font-style:italic;display:flex;gap:8px;align-items:center}
    .msg.g .cite::before{content:"";width:14px;height:1px;background:var(--rule-strong)}
    .chat-sample{padding:16px 20px;display:flex;gap:8px;flex-wrap:wrap;background:var(--paper-card);border-top:1px solid var(--rule)}
    .chip{font-size:12.5px;color:var(--accent);border:1px solid var(--rule-strong);border-radius:999px;padding:6px 12px;cursor:pointer;transition:.2s;background:transparent;font-family:var(--font-body);text-decoration:none}
    .chip:hover{background:var(--accent);color:#fff;border-color:var(--accent)}
    .chat-ask{display:flex;gap:8px;padding:14px 20px;background:var(--paper-card);border-top:1px solid var(--rule)}
    .chat-ask input{flex:1;border:1px solid var(--rule-strong);border-radius:999px;padding:11px 16px;font-size:14.5px;font-family:var(--font-body);background:#fff;color:var(--ink);outline:none}
    .chat-ask input:focus{border-color:var(--accent)}
    .chat-ask-send{flex:none;width:42px;border:0;border-radius:999px;background:var(--accent);color:#fff;font-size:15px;cursor:pointer;transition:opacity .2s}
    .chat-ask-send:disabled{opacity:.45;cursor:default}
    .msg.g.thinking .gbody{color:var(--ink-muted)}

    /* footer */
    .foot{background:var(--ink);color:#c5d2d4;padding:74px 0 40px}
    .foot-top{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:40px;padding-bottom:48px;border-bottom:1px solid #ffffff1f}
    .foot-mark{line-height:0}
    .foot-mark img{height:54px;width:auto;display:block}
    .foot-blurb{margin-top:16px;font-size:15px;color:#94a3a5;max-width:300px;line-height:1.6}
    .foot-col h4{font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:#86989a;margin-bottom:16px}
    .foot-col a,.foot-col button{display:block;padding:6px 0;font-size:15.5px;color:#c5d2d4;transition:color .2s;background:none;border:0;font-family:var(--font-body);cursor:pointer;text-align:left}
    .foot-col a:hover,.foot-col button:hover{color:#eaf6f9}
    .foot-bottom{padding-top:26px;display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;font-size:13px;color:#86989a}
    .foot-bottom .method{font-style:italic}
    .foot-bottom a{color:#c5d2d4;text-decoration:underline;text-underline-offset:2px}

    /* chat flotante (WhatsApp de Giora) */
    .fab{position:fixed;right:22px;bottom:22px;z-index:80;display:inline-flex;align-items:center;gap:10px;background:var(--accent);color:#fff;border:0;border-radius:999px;padding:13px 20px 13px 16px;font-family:var(--font-body);font-size:15px;font-weight:600;cursor:pointer;box-shadow:0 16px 40px -14px rgba(4,18,28,.6);text-decoration:none;transition:transform .2s,background .2s}
    .fab:hover{transform:translateY(-2px);background:var(--accent-ink)}
    .fab svg{width:20px;height:20px}

    /* reveal */
    .reveal{opacity:0;transform:translateY(22px);transition:opacity .7s ease,transform .7s cubic-bezier(.2,.7,.2,1)}
    .reveal.in{opacity:1;transform:none}
    @media (prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none;transition:none}}

    /* responsive */
    @media(max-width:900px){
      .cards{grid-template-columns:repeat(2,1fr)}
      .giora-grid{grid-template-columns:1fr;gap:40px}
      .foot-top{grid-template-columns:1fr 1fr}
      .nav-links{display:none}
      .nav-toggle{display:inline-flex}
    }
    @media(max-width:680px){
      .wrap{padding:0 22px}
      .hero-inner,.hero-foot{padding-left:22px;padding-right:22px}
      body{font-size:17px}
      .band{padding:72px 0}
      .sec-head{flex-direction:column;align-items:flex-start;gap:14px}
      .cards{grid-template-columns:1fr}
      .regions,.glossary{grid-template-columns:minmax(0,1fr);gap:0}
      .region-col:first-child{border-right:0;border-bottom:1px solid var(--rule);padding-right:0}
      .region-col:last-child{padding-left:0}
      .entry{grid-template-columns:1fr;gap:8px}
      .foot-top{grid-template-columns:1fr 1fr;gap:30px}
      .search-box{height:60px}
      .search input{font-size:17px}
      .search-kbd{display:none}
      .fab span{display:none}
    }
    @media(max-width:460px){.foot-top{grid-template-columns:1fr}}
  </style>
<!-- Umami (analitica propia, sin cookies ni datos personales) -->
<script defer src="https://umami-scibasku.vercel.app/script.js" data-website-id="49faed99-e484-4618-8f78-e095cf9f421e"></script>
</head>
<body>

<!-- ================= NAV ================= -->
<nav class="nav" id="nav">
  <div class="nav-inner">
    <a href="#top" class="nav-mark" aria-label="Scubapedia — inicio"><img src="/scubapedia-logo-nav.png" alt="Scubapedia" /></a>
    <div class="nav-links">
      <a class="nav-link" href="#destacadas">Destacadas</a>
      <a class="nav-link" href="#zonas">Zonas</a>
      <a class="nav-link" href="#conceptos">Conceptos</a>
      <a class="nav-link" href="/mapa/">Mapa</a>
      <a class="nav-link" href="/quiz/">Quiz</a>
      <a class="nav-link" href={CRUCERO} target="_blank" rel="noopener">Reservar</a>
      <a class="nav-cta" href={WA} data-open-chat target="_blank" rel="noopener">Pregúntale a Giora</a>
    </div>
    <a class="nav-toggle nav-cta" href={WA} target="_blank" rel="noopener">Giora</a>
  </div>
</nav>

<!-- ================= HERO ================= -->
<header class="hero" id="top">
  {heroPhoto
    ? <><img class="hero-photo" src={heroPhoto} alt="" fetchpriority="high" /><div class="hero-scrim"></div></>
    : <div class="hero-bg"></div>}
  <div class="hero-rays"></div>
  <div class="hero-grain"></div>
  <div class="hero-wave">
    <svg viewBox="0 0 224.8 60" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg"><path d="M0 37s21.3-24.7 28-25.9c6.8-1.2 18.5 16.7 21.8 15.7 3.3-1 22.5-25.6 26.3-26.8 3.8-1.2 28.2 24.8 31.1 29.2 2.9 4.4 3.8 7.7-.9 3.5-5.9-5.1-18.1-18.9-18.9-18.6-.8.3-4.5 11.5-6.4 10.9-2-.6-6.1-12-6.9-11.4-.8.5-4.9 7-6 6.9s-3.3-4.9-3.3-4.9-11.6 16.3-15.1 15C46.3 29.4 39 22.3 39 22.3s-.4 5.1-.9 5.3c-.5.2-.7 1.7-8.5-5.4 0 0-3.3 8-4.9 8s-4.9-8.9-4.9-8.9S1 43.6 0 37z" fill="#cdeef6"/></svg>
  </div>

  <div class="hero-inner">
    <div class="masthead-rule">
      <span class="line"></span>
      <span class="label">Est. 2026 · Edición de profundidad</span>
      <span class="line"></span>
    </div>

    <h1 class="wordmark"><img src="/scubapedia-logo.png" alt="Scubapedia — Enciclopedia de buceo" /></h1>

    <p class="slogan">
      Enciclopedia editorial de destinos de buceo en castellano.
      <span class="dot">·</span><b>Datos verificables, sin marketing vacío.</b>
    </p>

    <p style="margin:0 0 1.4rem"><a class="scp-cap-cta" href="#pedir-presupuesto">Pedir presupuesto a medida</a></p>

    <div class="search" id="search">
      <div class="search-box">
        <svg class="search-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="11" cy="11" r="7"></circle><line x1="16.5" y1="16.5" x2="21" y2="21"></line></svg>
        <input id="q" type="text" autocomplete="off" placeholder="Busca un destino, un mar o una especie…" aria-label="Buscar destino de buceo" />
        <span class="search-kbd">{totalFichas} fichas</span>
      </div>
      <div class="suggest" id="suggest"></div>
      <div class="search-sub">
        <span><i class="pip"></i> {totalFichas} destinos documentados</span>
        <span><i class="pip"></i> {totalZonas} zonas, del Mar Rojo al Pacífico</span>
        <span><i class="pip"></i> {gioraEstuvo} buceados por Giora</span>
      </div>
    </div>
  </div>

  <div class="hero-foot">
    <span class="scrollhint"><span class="v">↓</span> La selección de la redacción</span>
    <span>Portada · Edición 2026</span>
  </div>
</header>

<!-- ================= DESTACADAS ================= -->
<section class="band" id="destacadas">
  <div class="wrap">
    <div class="topline reveal"></div>
    <div class="sec-head reveal" style="margin-top:28px">
      <div class="h-l">
        <span class="eyebrow">Selección de la redacción</span>
        <h2 class="sec-title">Destacados</h2>
        <p class="standfirst">Seis destinos que vale la pena entender antes de sumergirte. Elegidos por su fauna y su carácter, no por su presupuesto de publicidad.</p>
      </div>
      <a href="#zonas" class="more-link">Ver los {totalFichas} destinos →</a>
    </div>

    <div class="cards reveal">
      {destacadas.map((d) => (
        <article class="card">
          <div class="card-top"><span class="card-idx">{d.idx} / 06</span><span class="card-region">{d.region}</span></div>
          <a href={d.url} class="card-figure" aria-label={d.title}>
            {d.img
              ? <img class="fg-img" src={d.img} alt={d.title} loading="lazy" decoding="async" />
              : <><span class="fg-grad" style={`background:${d.grad}`}></span><span class="fg-wave"><svg viewBox="0 0 224.8 50" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg"><path d="M0 37s21.3-24.7 28-25.9c6.8-1.2 18.5 16.7 21.8 15.7 3.3-1 22.5-25.6 26.3-26.8 3.8-1.2 28.2 24.8 31.1 29.2 2.9 4.4 3.8 7.7-.9 3.5-5.9-5.1-18.1-18.9-18.9-18.6-.8.3-4.5 11.5-6.4 10.9-2-.6-6.1-12-6.9-11.4-.8.5-4.9 7-6 6.9s-3.3-4.9-3.3-4.9-11.6 16.3-15.1 15C46.3 29.4 39 22.3 39 22.3s-.4 5.1-.9 5.3c-.5.2-.7 1.7-8.5-5.4 0 0-3.3 8-4.9 8s-4.9-8.9-4.9-8.9S1 43.6 0 37z" fill="#bfe8f2"/></svg></span></>}
            {d.giora && <span class="fg-giora">✦ Giora buceó aquí</span>}
            <span class="fg-z">{d.region}</span>
          </a>
          <h3 class="card-name"><a href={d.url}>{d.title}</a></h3>
          <p class="card-note">{d.note}</p>
          <div class="card-meta">
            <span class="card-country">{d.pais}</span>
            <span class="card-cert">{d.cert}</span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ================= ZONAS (directorio) ================= -->
<section class="band alt" id="zonas">
  <div class="wrap">
    <div class="sec-head reveal">
      <div class="h-l">
        <span class="eyebrow">Índice por zonas</span>
        <h2 class="sec-title">El mapa, ordenado</h2>
        <p class="standfirst">{totalFichas} destinos agrupados por mar y océano. El número es de fichas publicadas y revisadas, no de folletos vendidos.</p>
      </div>
      <a href={CRUCERO} target="_blank" rel="noopener" class="more-link">Reservar en crucerobuceo →</a>
    </div>

    <div class="regions reveal">
      {[colA, colB].map((col) => (
        <div class="region-col">
          {col.map((blk) => (
            <div class="zona-blk">
              <div class="zona-h"><h3>{blk.zona}</h3><span class="tot"><b>{blk.destinos.length}</b> destinos</span></div>
              <p class="zona-sub">{blk.blurb}</p>
              {blk.destinos.map((dest) => (
                <a class="idx-row" href={dest.url}>
                  <span class="idx-name">{dest.title}{dest.giora && <span class="idx-giora">✦</span>}</span>
                  <span class="idx-lead"></span>
                  <span class="idx-cert">{dest.cert}</span>
                  <span class="idx-arrow">→</span>
                </a>
              ))}
            </div>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ================= CONCEPTOS ================= -->
<section class="band" id="conceptos">
  <div class="wrap">
    <div class="sec-head reveal">
      <div class="h-l">
        <span class="eyebrow">Glosario</span>
        <h2 class="sec-title">Conceptos</h2>
        <p class="standfirst">Un vocabulario breve para leer el mar. Lo que de verdad cambia una inmersión, definido sin rodeos.</p>
      </div>
    </div>
    <div class="glossary reveal">
      {GLOSARIO.map((g) => (
        <div class="entry">
          <div class="term">{g.term}<span class="en">{g.en}</span><span class="pos">{g.pos}</span></div>
          <p class="def">{g.def}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ================= ASISTENTE ================= -->
<section class="band giora-band" id="giora">
  <div class="wrap">
    <div class="giora-grid">
      <div class="reveal">
        <span class="eyebrow giora-eyebrow">El asistente de Scubapedia</span>
        <h2 class="giora-title">Pregúntale a <i>Giora</i></h2>
        <p class="giora-copy">Giora lleva más de 20 años organizando liveaboards de buceo por todo el mundo. Cuéntale qué buscas —fechas, fauna, nivel, presupuesto— y te dice dónde y cuándo, con la experiencia de quien ha estado allí.</p>
        <div class="giora-feat">
          <div class="gf"><b>Compara</b><span>Profundidad, visibilidad y mejor época entre dos o más destinos.</span></div>
          <div class="gf"><b>Planifica</b><span>Qué barco, qué ruta y para qué nivel sirve cada zona.</span></div>
          <div class="gf"><b>Reserva</b><span>Del destino al liveaboard, con la agencia detrás (CICMA 2283).</span></div>
        </div>
        <a class="giora-cta" href={WA} data-open-chat target="_blank" rel="noopener"><span class="star">✦</span> Preguntar a Giora ahora</a>
      </div>

      <div class="chat-card reveal">
        <div class="chat-head">
          <div class="chat-ava">G</div>
          <div class="chat-id"><b>Giora</b><span>Buceador · Scubapedia</span></div>
          <div class="chat-status"><span class="d"></span> En línea</div>
        </div>
        <div class="chat-body" id="giora-body">
          <div class="msg u">¿Dónde veo mantas oceánicas en enero?</div>
          <div class="msg g">
            <div class="gtag">Giora</div>
            <div class="gbody">En enero la apuesta fuerte es Socorro (Revillagigedo): mantas gigantes oceánicas que se acercan de verdad, más jorobadas de paso. Si prefieres Maldivas, Hanifaru ya ha cerrado su temporada de agregación; ahí el invierno va de tiburones y mantas de arrecife. ¿Te comparo las dos por nivel y precio?</div>
            <div class="cite">Fuente: fichas de Socorro y Maldivas (Baa · Hanifaru).</div>
          </div>
        </div>
        <div class="chat-sample" id="giora-chips">
          <button type="button" class="chip" data-q="¿Dónde veo mantas oceánicas en enero?">¿Dónde veo mantas en enero?</button>
          <button type="button" class="chip" data-q="Mar Rojo vs Maldivas, ¿cuál me recomiendas?">Mar Rojo vs Maldivas</button>
          <button type="button" class="chip" data-q="Estoy empezando, ¿cuál es un buen primer liveaboard?">Primer liveaboard</button>
        </div>
        <form class="chat-ask" id="giora-form">
          <input id="giora-input" type="text" placeholder="Escríbele a Giora…" autocomplete="off" />
          <button type="submit" class="chat-ask-send" aria-label="Enviar">✦</button>
        </form>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const body = document.getElementById('giora-body');
    const chips = document.getElementById('giora-chips');
    const form = document.getElementById('giora-form');
    const input = document.getElementById('giora-input');
    const sendBtn = form ? form.querySelector('.chat-ask-send') : null;
    if (!body || !form || !input) return;
    const WA = 'https://wa.me/34619401041';
    const esc = (t) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;');
    const md = (t) => esc(t).replace(/\*\*([^*]+)\*\*/g, '<b>$1</b>').replace(/\*([^*]+)\*/g, '<i>$1</i>').replace(/\n/g, '<br/>');
    let history = [];
    let busy = false;
    let sessionId = null;
    try { sessionId = sessionStorage.getItem('giora_session'); } catch (e) {}

    function addUser(text) {
      const d = document.createElement('div'); d.className = 'msg u'; d.textContent = text;
      body.appendChild(d); body.scrollTop = body.scrollHeight;
    }
    function addGiora() {
      const wrap = document.createElement('div'); wrap.className = 'msg g thinking';
      const tag = document.createElement('div'); tag.className = 'gtag'; tag.textContent = 'Giora'; wrap.appendChild(tag);
      const gb = document.createElement('div'); gb.className = 'gbody'; gb.textContent = 'Giora está escribiendo…'; wrap.appendChild(gb);
      body.appendChild(wrap); body.scrollTop = body.scrollHeight;
      return wrap;
    }
    function setChips(arr) {
      if (!chips) return;
      const list = (arr && arr.length) ? arr : ['¿Mejor época para Raja Ampat?', 'Mar Rojo vs Maldivas', 'Primer liveaboard'];
      chips.innerHTML = '';
      list.forEach((q) => {
        const b = document.createElement('button'); b.type = 'button'; b.className = 'chip';
        b.textContent = q; b.dataset.q = q; chips.appendChild(b);
      });
    }
    // Misma idea que en ChatWidget: tras dos preguntas, ofrecer el formulario.
    // Se recoge el contacto donde ya vive el candado de consentimiento, no en
    // el chat.
    let contactoPedido = false;
    function pedirContacto() {
      if (contactoPedido || history.filter((m) => m.role === 'user').length < 2) return;
      contactoPedido = true;
      const d = document.createElement('div'); d.className = 'msg g';
      d.innerHTML = '<div class="gtag">Giora</div><div class="gbody">¿Quieres que te prepare una propuesta con precio cerrado? ' +
        '<a href="#pedir-presupuesto" style="color:var(--accent);text-decoration:underline;font-weight:600">Déjame tus datos aquí</a> ' +
        'y te contesto en menos de 24 horas laborables.</div>';
      body.appendChild(d); body.scrollTop = body.scrollHeight;
    }
    async function ask(text) {
      text = (text || '').trim();
      if (busy || !text) return;
      busy = true; input.value = ''; if (sendBtn) sendBtn.disabled = true;
      addUser(text);
      history.push({ role: 'user', content: text });
      const wrap = addGiora();
      const gb = wrap.querySelector('.gbody');
      try {
        const res = await fetch('/api/chat', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ messages: history, sessionId }) });
        if (!res.ok) throw new Error('bad');
        const r = await res.json();
        if (!r || !r.content) throw new Error('nocontent');
        if (r.sessionId) { sessionId = r.sessionId; try { sessionStorage.setItem('giora_session', sessionId); } catch (e) {} }
        wrap.classList.remove('thinking');
        gb.innerHTML = md(r.content);
        if (r.fuente) { const c = document.createElement('div'); c.className = 'cite'; c.textContent = 'Fuente: ' + r.fuente; wrap.appendChild(c); }
        history.push({ role: 'assistant', content: r.content });
        pedirContacto();
        setChips(r.sugerencias);
        try { gtag('event', 'giora_panel_reply'); } catch (e) {}
      } catch (e) {
        wrap.classList.remove('thinking');
        gb.innerHTML = 'Ahora mismo no puedo responderte por aquí. <a href="' + WA + '" target="_blank" rel="noopener" style="color:var(--accent);text-decoration:underline;font-weight:600">Escríbeme por WhatsApp</a> y te ayudo en persona.';
      } finally {
        busy = false; if (sendBtn) sendBtn.disabled = false; body.scrollTop = body.scrollHeight; input.focus();
      }
    }
    form.addEventListener('submit', (e) => { e.preventDefault(); ask(input.value); });
    if (chips) chips.addEventListener('click', (e) => { const b = e.target.closest('.chip'); if (b && b.dataset.q) ask(b.dataset.q); });
  })();
</script>

