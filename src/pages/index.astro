<script is:inline>
  (function () {
    var nav = document.getElementById('nav');
    var hero = document.getElementById('top');
    if (nav && hero && 'IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) {
        nav.classList.toggle('solid', !entries[0].isIntersecting);
      }, { rootMargin: '-72px 0px 0px 0px', threshold: 0 }).observe(hero);
    }
    if ('IntersectionObserver' in window) {
      var ro = new IntersectionObserver(function (ents) {
        ents.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('in'); ro.unobserve(en.target); } });
      }, { threshold: 0.12 });
      document.querySelectorAll('.reveal').forEach(function (n) { ro.observe(n); });
    } else {
      document.querySelectorAll('.reveal').forEach(function (n) { n.classList.add('in'); });
    }
  })();
</script>

<script is:inline define:vars={{ idx: searchIdx }}>
  (function () {
    var q = document.getElementById('q');
    var suggest = document.getElementById('suggest');
    var search = document.getElementById('search');
    if (!q || !suggest || !search) return;
    var activeIdx = -1, results = [];
    var norm = function (s) { return s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, ''); };
    function go(item) { if (item && item.u) window.location.href = item.u; }
    function runSearch() {
      var v = norm(q.value.trim());
      if (!v) { suggest.classList.remove('open'); return; }
      results = idx.filter(function (s) { return norm(s.t).indexOf(v) >= 0 || norm(s.c).indexOf(v) >= 0; }).slice(0, 7);
      activeIdx = -1;
      if (!results.length) {
        suggest.innerHTML = '<div class="sg-empty">Sin resultados para “' + q.value.trim() + '”. Prueba con un mar o un país.</div>';
        suggest.classList.add('open'); return;
      }
      var re = new RegExp('(' + v.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'i');
      suggest.innerHTML = '<div class="sg-head">' + results.length + ' de ' + idx.length + ' fichas</div>' + results.map(function (s, i) {
        var hl = s.t.replace(re, '<b>$1</b>');
        var meta = s.c + (s.m ? ' · ' + s.m : '');
        return '<div class="sg-item" data-i="' + i + '"><span class="sg-name">' + hl + '</span><span class="sg-meta">' + meta + '</span></div>';
      }).join('');
      suggest.classList.add('open');
      suggest.querySelectorAll('.sg-item').forEach(function (it) {
        it.addEventListener('click', function () { go(results[+it.dataset.i]); });
      });
    }
    q.addEventListener('input', runSearch);
    q.addEventListener('focus', function () { if (q.value.trim()) runSearch(); });
    q.addEventListener('keydown', function (e) {
      var items = suggest.querySelectorAll('.sg-item');
      if (e.key === 'ArrowDown') { e.preventDefault(); activeIdx = Math.min(activeIdx + 1, items.length - 1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); activeIdx = Math.max(activeIdx - 1, 0); }
      else if (e.key === 'Enter') {
        e.preventDefault();
        if (activeIdx >= 0 && results[activeIdx]) go(results[activeIdx]);
        else if (results[0]) go(results[0]);
        return;
      } else return;
      items.forEach(function (it, i) { it.classList.toggle('active', i === activeIdx); });
    });
    document.addEventListener('click', function (e) { if (!search.contains(e.target)) suggest.classList.remove('open'); });
  })();
</script>

