---
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import '../styles/global.css';
import '../styles/carta.css';
const WA = 'https://wa.me/34619401041';
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Página no encontrada — Scubapedia</title>
  <meta name="robots" content="noindex" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <style is:global>
    html,body{overflow-x:clip}
    .perdido{min-height:calc(100svh - var(--nav-h) - 360px);min-height:max(420px,calc(100svh - var(--nav-h) - 360px));display:flex;align-items:center}
    .perdido .in{max-width:var(--maxw);margin:0 auto;padding:var(--s-16) var(--gutter);width:100%}
    .perdido .codigo{color:var(--ink-2);margin-bottom:var(--s-4)}
    .perdido h1{font-style:italic;font-size:clamp(40px,7vw,88px);line-height:1.02;letter-spacing:0;max-width:14ch;margin-bottom:var(--s-5)}
    .perdido p{font-size:20px;line-height:1.5;color:var(--ink-2);max-width:46ch;margin:0 0 var(--s-8)}
    .perdido .actions{display:flex;gap:var(--s-3);flex-wrap:wrap}
    .perdido .btn{text-decoration:none}
    @media (max-width:560px){.perdido .btn{width:100%;justify-content:space-between}}
  </style>
<!-- Umami (analitica propia, sin cookies ni datos personales) -->
<script defer src="https://umami-scibasku.vercel.app/script.js" data-website-id="49faed99-e484-4618-8f78-e095cf9f421e"></script>
</head>
<body>
  <Cabecera />
  <main class="perdido">
    <div class="in">
      <div class="codigo lab">Error 404</div>
      <h1>Esta sonda no marca nada</h1>
      <p>La página que buscabas no está en la carta, o se ha movido de sitio. Vuelve a la portada o abre el mapa y busca de nuevo.</p>
      <div class="actions">
        <a class="btn" href="/">Volver a la portada</a>
        <a class="btn sec" href="/mapa/">Abrir el mapa</a>
        <a class="btn sec" href={WA} target="_blank" rel="noopener">Preguntarle a Giora</a>
      </div>
    </div>
  </main>
  <Pie />
</body>
</html>
