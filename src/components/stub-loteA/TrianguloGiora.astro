---
// STUB DEL LOTE A — se borra al integrar: el bueno es src/components/TrianguloGiora.astro (Lote B).
interface Props { size?: number; label?: string }
const { size = 15, label = 'Buceado por Giora' } = Astro.props;
---
<svg class="tri-giora" width={size} height={Math.round(size * 13 / 15)} viewBox="0 0 15 13" role="img" aria-label={label}><path d="M7.5 1 14 12H1Z" fill="none" stroke="#d6006f" stroke-width="1.3" /></svg>
