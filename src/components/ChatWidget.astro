---
// Asistente "Giora AI" de Scubapedia — chat flotante que responde con IA
// sobre los destinos de buceo (endpoint /api/chat). Portado del de SkiPedia,
// adaptado a buceo. Si la IA falla, deriva a WhatsApp.
---
<button
  id="chat-trigger"
  class="fixed bottom-6 right-6 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-[var(--color-link)] text-white shadow-xl hover:scale-105 transition-transform cursor-pointer border-0"
  aria-label="Abrir asistente Giora AI"
>
  <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
  </svg>
</button>

<div
  id="chat-window"
  class="fixed bottom-24 right-6 z-50 hidden h-[520px] w-[370px] max-w-[calc(100vw-2rem)] flex flex-col rounded-xl bg-[var(--color-paper)] border border-[var(--color-border)] shadow-2xl overflow-hidden font-sans"
>
  <header class="flex items-center justify-between px-4 py-3 bg-[color-mix(in_oklab,var(--color-paper),black_4%)] border-b border-[var(--color-border)]">
    <div class="flex items-center gap-2.5">
      <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-[var(--color-link)] text-white font-serif font-semibold">G</span>
      <div>
        <span class="font-serif text-base font-semibold block text-[var(--color-ink)] leading-tight">Giora <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 align-middle ml-1 animate-pulse"></span></span>
        <span class="text-[10px] text-[var(--color-muted)] block">Asistente de buceo · Scubapedia</span>
      </div>
    </div>
    <button id="chat-close" class="text-[var(--color-muted)] hover:text-[var(--color-ink)] cursor-pointer border-0 bg-transparent p-1 rounded" aria-label="Cerrar chat">
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
    </button>
  </header>

  <div id="chat-messages" class="flex-1 min-h-0 p-4 overflow-y-auto space-y-3.5 bg-[color-mix(in_oklab,var(--color-bg),transparent_50%)]">
    <div class="chat-message assistant flex gap-2">
      <div class="px-3.5 py-2.5 rounded-lg bg-[var(--color-paper)] border border-[var(--color-border)] text-[13px] leading-relaxed text-[var(--color-ink)] max-w-[88%]">
        Hola, soy <b>Giora</b>. Llevo más de 20 años organizando viajes de buceo. Pregúntame sin rodeos: <b>dónde ver mantas o tiburones</b>, qué <b>nivel</b> necesitas, la <b>mejor época</b>, o qué liveaboard encaja contigo. ¿Qué buscas?
      </div>
    </div>
  </div>

  <div id="chat-typing" class="hidden px-4 py-2 text-[10px] text-[var(--color-muted)] italic bg-transparent">Giora está escribiendo…</div>

  <footer class="p-3 border-t border-[var(--color-border)] bg-[var(--color-paper)] flex gap-2">
    <input type="text" id="chat-input" placeholder="¿Dónde veo mantas en enero?" class="flex-1 px-3 py-2 text-[13px] border border-[var(--color-border)] rounded-md focus:outline-none focus:border-[var(--color-accent)] bg-[var(--color-bg)] text-[var(--color-ink)]" />
    <button id="chat-send" class="px-4 py-2 bg-[var(--color-link)] text-white text-[13px] font-semibold rounded-md hover:opacity-90 transition-opacity cursor-pointer border-0">Enviar</button>
  </footer>
</div>

<script is:inline>
  (() => {
    const trigger = document.getElementById('chat-trigger');
    const windowEl = document.getElementById('chat-window');
    const closeBtn = document.getElementById('chat-close');
    const messagesEl = document.getElementById('chat-messages');
    const inputEl = document.getElementById('chat-input');
    const sendBtn = document.getElementById('chat-send');
    const typingEl = document.getElementById('chat-typing');
    const WA = 'https://wa.me/34619401041';
    let history = [];

    const cached = sessionStorage.getItem('scubapedia_chat_history');
    if (cached) { try { history = JSON.parse(cached); history.forEach(m => appendMessageUI(m.role, m.content)); } catch (e) {} }

    function openChat(){ windowEl.classList.remove('hidden'); inputEl.focus(); scrollToBottom(); }
    trigger.addEventListener('click', () => { windowEl.classList.toggle('hidden'); if (!windowEl.classList.contains('hidden')) { inputEl.focus(); scrollToBottom(); } });
    closeBtn.addEventListener('click', () => windowEl.classList.add('hidden'));
    // Permite abrir el chat desde cualquier botón con [data-open-chat]
    document.querySelectorAll('[data-open-chat]').forEach(el => el.addEventListener('click', (e) => { e.preventDefault(); openChat(); }));

    async function sendMessage() {
      const text = inputEl.value.trim();
      if (!text) return;
      inputEl.value = '';
      appendMessageUI('user', text);
      history.push({ role: 'user', content: text });
      saveHistory(); scrollToBottom();
      inputEl.disabled = true; sendBtn.disabled = true; typingEl.classList.remove('hidden');
      try {
        const res = await fetch('/api/chat', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ messages: history }) });
        if (!res.ok) throw new Error('bad status');
        const reply = await res.json();
        if (!reply || !reply.content) throw new Error('no content');
        appendMessageUI('assistant', reply.content);
        history.push({ role: 'assistant', content: reply.content });
        saveHistory();
        try { gtag('event', 'chat_reply'); } catch(e){}
      } catch (err) {
        appendMessageUI('assistant', 'Ahora mismo no puedo responderte por aquí. <a href="' + WA + '" target="_blank" rel="noopener" style="color:var(--color-link);text-decoration:underline;font-weight:600">Escríbeme por WhatsApp</a> y te ayudo en persona.');
      } finally {
        inputEl.disabled = false; sendBtn.disabled = false; typingEl.classList.add('hidden'); inputEl.focus(); scrollToBottom();
      }
    }
    sendBtn.addEventListener('click', sendMessage);
    inputEl.addEventListener('keypress', (e) => { if (e.key === 'Enter') sendMessage(); });

    function appendMessageUI(role, text) {
      const wrapper = document.createElement('div');
      wrapper.className = `chat-message ${role} flex gap-2 ${role === 'user' ? 'justify-end' : ''}`;
      const bubble = document.createElement('div');
      bubble.className = `px-3.5 py-2.5 rounded-lg text-[13px] leading-relaxed max-w-[88%] ${role === 'user' ? 'bg-[var(--color-link)] text-white border border-transparent' : 'bg-[var(--color-paper)] text-[var(--color-ink)] border border-[var(--color-border)]'}`;
      bubble.innerHTML = text.replace(/\*\*([^*]+)\*\*/g, '<b>$1</b>').replace(/\*([^*]+)\*/g, '<i>$1</i>').replace(/\n/g, '<br/>');
      wrapper.appendChild(bubble); messagesEl.appendChild(wrapper);
    }
    function scrollToBottom() { messagesEl.scrollTop = messagesEl.scrollHeight; }
    function saveHistory() { sessionStorage.setItem('scubapedia_chat_history', JSON.stringify(history)); }
  })();
</script>
