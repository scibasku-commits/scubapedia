---
// Cabecera común del sitio «Carta náutica». Fuente: DECISION.md §3.3.
// Fija, 60 px, papel con filete de tinta. Una sola tinta en el logotipo.
// El contador Umami NO va aquí: vive en el <head> de cada página.
interface Props {
  /** Enlace de la página actual: 'sondas' | 'indice' | 'mapa' | 'quiz' | 'giora' */
  activa?: string;
}
const { activa = '' } = Astro.props;
const ENLACES = [
  { id: 'sondas', t: 'Tabla de sondas', href: '/#sondas' },
  { id: 'indice', t: 'Índice', href: '/#indice' },
  { id: 'mapa', t: 'Mapa', href: '/mapa/' },
  { id: 'quiz', t: 'Quiz', href: '/quiz/' },
  { id: 'giora', t: 'Pregúntale a Giora', href: '/#giora', marco: true },
];
---
<header class="cab" id="cabecera">
  <div class="cab-in">
    <a class="cab-logo" href="/" aria-label="Scubapedia, inicio"><img src="/scubapedia-logo-nav-white.png" alt="Scubapedia" width="112" height="28" /></a>
    <div class="cab-extra"><slot name="extra" /></div>
    <nav class="cab-nav" aria-label="Principal">
      {ENLACES.map((e) => (
        <a class={`lab${e.marco ? ' marco' : ''}${activa === e.id ? ' act' : ''}`} href={e.href} aria-current={activa === e.id ? 'page' : undefined}>{e.t}</a>
      ))}
    </nav>
    <button class="cab-menu lab" type="button" id="cab-menu" aria-expanded="false" aria-controls="cab-panel">Menú</button>
  </div>
  <nav class="cab-panel" id="cab-panel" aria-label="Menú" hidden>
    {ENLACES.map((e) => (
      <a class={`rot${activa === e.id ? ' act' : ''}`} href={e.href} aria-current={activa === e.id ? 'page' : undefined}>{e.t}</a>
    ))}
  </nav>
</header>

<style>
  .cab{position:sticky;top:0;z-index:70;height:var(--nav-h);background:var(--paper);border-bottom:1px solid var(--ink)}
  .cab-in{max-width:var(--maxw);margin:0 auto;padding:0 var(--gutter);height:100%;display:flex;align-items:center;justify-content:space-between;gap:var(--s-6)}
  .cab-logo{display:flex;align-items:center;flex:none}
  .cab-logo img{height:28px;width:auto;filter:brightness(0)}
  .cab-extra{margin-left:auto;display:flex;align-items:center}
  .cab-nav{display:flex;align-items:center;gap:var(--s-6)}
  .cab-nav a{color:var(--ink);padding:6px 0;border-bottom:1px solid transparent;line-height:1.2}
  .cab-nav a:hover{color:var(--mag-ink)}
  .cab-nav a.act{border-bottom-color:var(--mag)}
  .cab-nav a.marco{border:1px solid var(--ink);padding:9px 14px}
  .cab-nav a.marco.act{border-color:var(--mag)}
  .cab-menu{display:none;min-height:44px;min-width:44px;padding:0 var(--s-4);cursor:pointer}
  .cab-menu[aria-expanded="true"]{background:var(--ink);color:var(--paper)}
  .cab-panel{position:fixed;left:0;right:0;top:var(--nav-h);bottom:0;background:var(--paper);display:flex;flex-direction:column;padding:var(--s-4) var(--gutter);overflow-y:auto}
  .cab-panel[hidden]{display:none}
  .cab-panel a{min-height:56px;display:flex;align-items:center;font-size:26px;border-bottom:1px dotted var(--dots);color:var(--ink)}
  .cab-panel a.act{color:var(--mag-ink)}
  @media (max-width:760px){
    .cab-nav{display:none}
    .cab-extra{display:none}
    .cab-menu{display:inline-flex;align-items:center;justify-content:center}
    .cab-in{justify-content:space-between}
  }
  @media (min-width:761px){.cab-panel{display:none !important}}
</style>

<script>
  const btn = document.getElementById('cab-menu');
  const panel = document.getElementById('cab-panel');
  if (btn && panel) {
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      btn.textContent = open ? 'Cerrar' : 'Menú';
      panel.hidden = !open;
      document.documentElement.style.overflow = open ? 'hidden' : '';
    };
    btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') { set(false); (btn as HTMLElement).focus(); }
    });
    panel.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
    window.matchMedia('(min-width:761px)').addEventListener('change', (m) => { if (m.matches) set(false); });
  }
</script>
