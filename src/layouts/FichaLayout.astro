---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { normalizeZona } from '../lib/zonas';
import { chips, lede, railRows, etiquetaCorta } from '../lib/ficha-datos';
import { crucerobuceoSlug, crucerobuceoUrl } from '../lib/crucerobuceo';
import { destinoImage } from '../lib/imagen';
import { datosClave, parseFaq } from '../lib/datos-clave';
import coordenadas from '../lib/coordenadas.json';
import CaptacionForm from '../components/CaptacionForm.astro';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import TrianguloGiora from '../components/TrianguloGiora.astro';
import '../styles/global.css';
import '../styles/carta.css';

interface Heading { depth: number; slug: string; text: string; }
interface Props {
  entry: CollectionEntry<'buceo'>;
  headings?: Heading[];
}

const { entry, headings = [] } = Astro.props;
const d = entry.data as Record<string, any>;
const id = entry.id.replace(/\.md$/, '');

const CRUCERO = 'https://crucerobuceo.com';
const WA = 'https://wa.me/34619401041';

const titleFull = d.title as string;
const titleShort = titleFull.split(' - ')[0].split(' — ')[0].trim();

// El nombre que se publica: el corto SI es único, y el completo solo cuando el corto
// chocaría con otra ficha.
//
// Cortar siempre por el guion dejaba a las nueve fichas de Maldivas llamándose «Maldivas»
// —el mismo <title> exacto para Google, y nueve filas idénticas en el buscador—. Pero usar
// siempre el completo mete en el <title> títulos que son frases editoriales enteras
// («Rapa Nui (Isla de Pascua) — Visibilidad extrema y endemismo del océano más aislado»):
// 61 de 122 pasaban de 65 caracteres y Google los corta.
const _cortos = new Map<string, number>();
for (const e of await getCollection('buceo')) {
  const c = (e.data.title as string).split(' - ')[0].split(' — ')[0].trim();
  _cortos.set(c, (_cortos.get(c) ?? 0) + 1);
}
const titleNombre = (_cortos.get(titleShort) ?? 0) > 1 ? titleFull : titleShort;
const zona = normalizeZona(d.region || '');
const regionShort = typeof d.region === 'string' ? d.region.split(',')[0].trim() : '';

const chipList = chips(d);
const ledeParts = lede(d);
const rows = railRows(d);

// Las 4 casillas de la hoja salen de chips(d): si falta un dato, se omite la casilla.
const CASILLAS: Array<[string, string]> = [['profundidad', 'Prof.'], ['visibilidad', 'Vis.'], ['temperatura', 'Agua'], ['cert. mínima', 'Nivel']];
const casillas = CASILLAS
  .map(([lab, k]) => { const c = chipList.find((x) => x.lab === lab); return c ? { k, v: c.num, txt: !!c.txt } : null; })
  .filter((c): c is { k: string; v: string; txt: boolean } => c !== null);

// Texto literal de la ficha; solo se convierte *nombre científico* en cursiva.
const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const inline = (t: string) => esc(String(t)).replace(/\*([^*]+)\*/g, '<em>$1</em>');
const fauna: string[] = Array.isArray(d.vida_marina_destacada) ? d.vida_marina_destacada.map((x: unknown) => String(x).trim()).filter(Boolean) : [];
const flota: string[] = Array.isArray(d.liveaboards_disponibles) ? d.liveaboards_disponibles.map((x: unknown) => String(x).trim()).filter(Boolean) : [];
const armadores: string[] = Array.isArray(d.proveedores_scibasku) ? d.proveedores_scibasku.map((x: unknown) => String(x).trim().toLowerCase()).filter(Boolean) : [];
const flotaMarcada = flota.map((n) => ({ n, propio: armadores.some((a) => n.toLowerCase().startsWith(a)) }));
const hayPropios = flotaMarcada.some((f) => f.propio);

// Cross-site → crucerobuceo (deep-link por destino si existe; si no, home)
const cbSlug = crucerobuceoSlug(id);
const cbUrl = crucerobuceoUrl(id);

// Foto real del destino (Cloudinary, vía crucerobuceo); null → degradado de zona
const heroImg = destinoImage(id, 'hero');

// Relacionadas: hasta 4 de la misma zona (excluyendo la actual)
const allBuceo = await getCollection('buceo');
const cercanas = allBuceo
  .filter((e) => e.id !== entry.id && normalizeZona(e.data.region || '') === zona)
  .sort((a, b) => a.data.title.localeCompare(b.data.title))
  .slice(0, 4)
  .map((e) => {
    const cid = e.id.replace(/\.md$/, '');
    return {
      id: cid,
      title: (() => { const full = (e.data.title as string).trim(); const c = full.split(' - ')[0].split(' — ')[0].trim(); return (_cortos.get(c) ?? 0) > 1 ? full : c; })(),
      region: (e.data.region || '').split(',')[0].trim(),
      cert: etiquetaCorta(e.data.certificacion_minima) ?? '',
    };
  });

const h2 = headings.filter((h) => h.depth === 2);

const canonicalUrl = new URL(`/destinos/${id}/`, Astro.site ?? 'https://www.scubapedia.org').toString();
const ogImage = destinoImage(id, 'og') ?? new URL('/og-default.png', Astro.site ?? 'https://www.scubapedia.org').toString();
const pageTitle = `${titleNombre} · Ficha de buceo — Scubapedia`;
const tempDesc = (d.temperatura_agua_min || d.temperatura_agua_max)
  ? `, ${d.temperatura_agua_min}–${d.temperatura_agua_max}°C`
  : '';
const desc = `Buceo en ${d.pais || titleShort}: ${d.visibilidad_media || 'visibilidad variable'}${tempDesc}. Cert. mínima: ${d.certificacion_minima || 'OW'}.`;
const arrow = '<path d="M5 12h14M13 6l6 6-6 6"/>';

// ---------- JSON-LD completo: Article + TouristAttraction (geo) + BreadcrumbList + autor E-E-A-T ----------
const SITE = (Astro.site ?? 'https://www.scubapedia.org').toString().replace(/\/$/, '');
const coords = (coordenadas as Record<string, { lat: number; lng: number }>)[id] ?? null;
const realOgImage = destinoImage(id, 'og'); // null si el destino no tiene foto propia
const AUTHOR_ID = `${SITE}/#giora`;
const ORG_ID = `${SITE}/#viajes-scibasku`;

const authorLd = {
  '@type': 'Person', '@id': AUTHOR_ID,
  name: 'Giora Gilead Elenberg',
  jobTitle: 'Agente de viajes especializado en buceo y esquí',
  worksFor: { '@id': ORG_ID },
  knowsAbout: ['Buceo recreativo', 'Liveaboards', 'Viajes de buceo', 'Cruceros de buceo'],
  url: 'https://viajesscibasku.com',
};

const orgLd = {
  '@type': 'TravelAgency', '@id': ORG_ID,
  name: 'Viajes Scibasku',
  url: 'https://viajesscibasku.com',
  identifier: { '@type': 'PropertyValue', propertyID: 'CICMA', value: '2283' },
};

const attractionLd: Record<string, unknown> = {
  '@type': 'TouristAttraction', '@id': `${canonicalUrl}#destino`,
  name: titleNombre, url: canonicalUrl, description: desc, touristType: 'Buceadores',
};
if (coords) attractionLd.geo = { '@type': 'GeoCoordinates', latitude: coords.lat, longitude: coords.lng };
if (d.pais) attractionLd.containedInPlace = { '@type': 'Country', name: d.pais };
if (cbSlug) attractionLd.isPartOf = { '@type': 'TouristDestination', name: `Cruceros de buceo en ${d.pais}`, url: cbUrl };

const articleLd: Record<string, unknown> = {
  '@type': 'Article', '@id': `${canonicalUrl}#article`,
  headline: `${titleNombre}: ficha de buceo`,
  description: desc,
  inLanguage: 'es',
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
  author: { '@id': AUTHOR_ID },
  publisher: { '@id': ORG_ID },
  about: { '@id': `${canonicalUrl}#destino` },
};
if (d.updated) articleLd.dateModified = d.updated;
if (d.published || d.created) articleLd.datePublished = d.published || d.created;
if (realOgImage) articleLd.image = realOgImage;

const breadcrumbLd = {
  '@type': 'BreadcrumbList', '@id': `${canonicalUrl}#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: zona, item: `${SITE}/#zonas` },
    { '@type': 'ListItem', position: 3, name: titleNombre },
  ],
};

const graph: Record<string, unknown>[] = [articleLd, attractionLd, breadcrumbLd, authorLd, orgLd];

// FAQPage solo si la ficha tiene sección "## Preguntas frecuentes" con ### preguntas
const faqs = parseFaq(entry.body);
if (faqs.length > 0) {
  graph.push({
    '@type': 'FAQPage', '@id': `${canonicalUrl}#faq`,
    mainEntity: faqs.map((f) => ({
      '@type': 'Question', name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}

const jsonLd = { '@context': 'https://schema.org', '@graph': graph };

// Sección "Datos clave" citable (desde frontmatter — toca el layout, impacta las 103)
const datos = datosClave(d, zona, coords);
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={desc} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={desc} />
  <meta property="og:type" content="article" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content="Scubapedia" />
  <meta property="og:locale" content="es_ES" />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={desc} />
  <meta name="twitter:image" content={ogImage} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-LHZYGMPX6K"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-LHZYGMPX6K');
  </script>
  <style is:global>
    html{scroll-behavior:smooth}
    html,body{overflow-x:clip}
    .btn,.fab,.mas-fila,.toc a,.foto a{text-decoration:none}
    .mas-fila{color:var(--ink)}
    .mas-fila:hover{color:var(--ink)}

    /* extra de la cabecera: aparece al bajar */
    .cta-mini{opacity:0;pointer-events:none;transition:opacity var(--t-med) var(--ease);padding:9px 14px;gap:8px}
    .cta-mini.show{opacity:1;pointer-events:auto}

    /* ---------- hoja de carta: cabecera ---------- */
    .hoja{padding:var(--s-10) 0 var(--s-8)}
    .hoja-top{display:flex;flex-wrap:wrap;gap:var(--s-2) var(--s-6);color:var(--ink-2);margin-bottom:var(--s-5)}
    .hoja-cols{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:var(--s-10);align-items:end;margin-bottom:var(--s-8)}
    .hoja h1{font-style:italic;font-weight:400;font-size:clamp(40px,5.2vw,72px);line-height:1.02;letter-spacing:0;max-width:16ch;overflow-wrap:break-word;color:var(--ink)}
    .hoja .lede{margin:var(--s-5) 0 0;font-size:20px;line-height:1.4;color:var(--ink-2);max-width:54ch}
    .hoja .lede .dot{padding:0 .4em;color:var(--mag-ink)}
    .hoja .giora-flag{display:inline-flex;align-items:center;gap:var(--s-2);margin-top:var(--s-4);color:var(--mag-ink)}
    .casillas{display:grid;grid-template-columns:repeat(4,minmax(112px,auto));border-top:1px solid var(--ink);border-bottom:1px solid var(--ink)}
    .casilla{padding:var(--s-3) var(--s-4);border-left:1px solid var(--rule-strong);display:flex;flex-direction:column;gap:var(--s-1);min-width:0}
    .casilla:first-child{border-left:0;padding-left:0}
    .casilla .v{font-family:var(--rot);font-size:26px;line-height:1.1;color:var(--ink);font-variant-numeric:tabular-nums}
    .casilla .v.txt{font-family:var(--lab);font-size:17px;line-height:1.25;max-width:20ch}
    .casilla .k{color:var(--ink-2)}
    .foto{margin:0;border:1px solid var(--ink);box-shadow:5px 6px 0 rgba(18,36,43,.10);background:var(--paper);position:relative}
    .foto .marco{aspect-ratio:16/9;position:relative;overflow:hidden;background:var(--water-2)}
    .foto img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:saturate(.84) contrast(1.05)}
    .foto svg.water{position:absolute;inset:0;width:100%;height:100%;display:block}
    .foto .topo{position:absolute;left:5%;bottom:9%;font-family:var(--rot);font-style:italic;font-size:clamp(22px,3.4vw,40px);color:var(--ink);text-shadow:0 0 6px var(--paper),0 0 12px var(--paper)}
    .foto figcaption{display:flex;justify-content:space-between;gap:var(--s-3);padding:7px 10px;border-top:1px solid var(--ink);background:var(--paper);color:var(--ink-2)}
    .hoja-btns{display:flex;flex-wrap:wrap;gap:var(--s-3);margin-top:var(--s-8)}

    /* ---------- cuerpo ---------- */
    .body-section{padding:var(--s-13) 0 var(--s-8)}
    .grid{display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:var(--s-16);align-items:start}
    .article{min-width:0}
    .article h1{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
    .article h2{font-family:var(--rot);font-weight:400;font-style:normal;font-size:clamp(28px,3.2vw,38px);line-height:1.1;margin:var(--s-13) 0 var(--s-4);scroll-margin-top:calc(var(--nav-h) + 16px);padding-top:var(--s-4);border-top:1px solid var(--ink)}
    .article h2:first-of-type{margin-top:0}
    .article h3{font-family:var(--rot);font-style:italic;font-weight:400;font-size:1.3rem;line-height:1.2;margin:var(--s-8) 0 var(--s-2)}
    .article p{margin:0 0 var(--s-4);max-width:64ch;color:var(--ink)}
    .article blockquote{margin:0 0 var(--s-8);font-family:var(--rot);font-size:1.35rem;line-height:1.45;max-width:58ch;border:0;padding:0 0 0 var(--s-5);border-left:1px solid var(--mag);font-style:normal}
    .article blockquote p{font-family:inherit}
    .article strong{font-weight:600}
    .article em{font-style:italic;color:var(--ink)}
    .article a{text-decoration:underline;text-underline-offset:3px;text-decoration-color:var(--rule-strong)}
    .article a:hover{color:var(--mag-ink);text-decoration-color:var(--mag)}
    .article ul,.article ol{margin:0 0 var(--s-4);padding-left:0;list-style:none;display:flex;flex-direction:column;gap:var(--s-2);max-width:64ch}
    .article ul li{position:relative;padding-left:26px;line-height:1.45}
    .article ul li::before{content:"—";position:absolute;left:0;top:0;color:var(--ink-2)}
    .article ol{counter-reset:li}
    .article ol li{counter-increment:li;position:relative;padding-left:30px;line-height:1.45}
    .article ol li::before{content:counter(li) ".";position:absolute;left:0;top:0;font-family:var(--lab);font-variant-numeric:tabular-nums;color:var(--ink-2)}
    .article table{width:100%;border-collapse:collapse;margin:var(--s-6) 0;font-size:16px}
    .article th,.article td{border:0;border-bottom:1px dotted var(--dots);padding:10px 12px 10px 0;text-align:left;vertical-align:top;background:transparent}
    .article th{border-bottom:1px solid var(--ink)}
    .article hr{border:0;border-top:1px solid var(--rule-strong);margin:var(--s-10) 0}
    /* la ficha guarda el JSON-LD en bloques de código: no se muestran */
    .article pre,.article :not(pre)>code{display:none}
    .article img{margin:var(--s-6) 0;border:1px solid var(--ink)}

    .datos-clave{margin:var(--s-13) 0 0;padding-top:var(--s-4);border-top:1px solid var(--ink)}
    .datos-clave h2{margin:0 0 var(--s-2);font-size:clamp(26px,3vw,34px);border:0;padding:0}
    .datos-clave .dc-intro{font-size:15px;color:var(--ink-2);margin:0 0 var(--s-4)}
    .datos-clave dl{margin:0;display:flex;flex-direction:column}
    .datos-clave .dc-row{display:grid;grid-template-columns:200px 1fr;gap:var(--s-4);padding:10px 0;border-bottom:1px dotted var(--dots)}
    .datos-clave dt{font-family:var(--lab);text-transform:uppercase;letter-spacing:.12em;font-size:11px;color:var(--ink-2);margin:0;padding-top:4px}
    .datos-clave dd{font-size:16px;margin:0;color:var(--ink)}

    .tagrow{display:flex;flex-wrap:wrap;gap:var(--s-2);margin:var(--s-8) 0 0;list-style:none;padding:0}
    .tagrow span{font-size:14px;padding:5px 10px;border:1px solid var(--rule-strong);color:var(--ink-2);background:transparent;display:inline-block}

    .autor-box{margin:var(--s-8) 0 0;padding:var(--s-5) var(--s-6);background:var(--white);border:1px solid var(--ink)}
    .autor-box .ab-head{color:var(--ink-2);margin-bottom:var(--s-2)}
    .autor-box .ab-body{font-size:16px;line-height:1.55;margin:0;max-width:none}
    .autor-box .ab-estuvo{display:flex;align-items:center;gap:var(--s-2);margin-top:var(--s-2);font-weight:600;color:var(--mag-ink)}
    .autor-box .ab-rev{font-size:14px;color:var(--ink-2);margin:var(--s-3) 0 0}

    /* ---------- notas de margen ---------- */
    .rail{position:sticky;top:calc(var(--nav-h) + 16px);display:flex;flex-direction:column;gap:var(--s-8);max-height:calc(100svh - var(--nav-h) - 32px);overflow-y:auto;padding-right:2px}
    .nota{border-top:1px solid var(--ink);padding-top:var(--s-3)}
    .nota h2{margin:0 0 var(--s-3);color:var(--ink-2)}
    .nota .row{display:flex;justify-content:space-between;gap:var(--s-4);padding:8px 0;border-bottom:1px dotted var(--dots);font-size:16px}
    .nota .row .k{color:var(--ink-2);flex:0 0 auto}
    .nota .row .v{text-align:right;flex:1 1 auto;min-width:0;overflow-wrap:anywhere}
    .nota .row .v.hi{font-weight:600}
    .nota .btn{margin-top:var(--s-4);width:100%;justify-content:space-between}
    .nota ul{list-style:none;margin:0;padding:0}
    .nota ul li{padding:7px 0;border-bottom:1px dotted var(--dots);font-size:16px;line-height:1.35}
    .nota ul li em{font-style:italic}
    .flota{display:flex;flex-wrap:wrap;gap:6px}
    .flota span{border:1px solid var(--ink);padding:5px 8px;color:var(--ink);line-height:1.2}
    .flota span.propio{border-color:var(--mag);color:var(--mag-ink)}
    .flota-nota{font-size:14px;color:var(--mag-ink);margin:var(--s-3) 0 0;line-height:1.4}
    .toc{display:flex;flex-direction:column}
    .toc a{display:block;padding:8px 0 8px var(--s-3);border-left:1px solid var(--rule-strong);font-size:16px;line-height:1.3;color:var(--ink-2)}
    .toc a:hover{color:var(--ink);border-left-color:var(--ink)}
    .toc a.active{color:var(--ink);border-left:2px solid var(--mag);padding-left:calc(var(--s-3) - 1px)}

    /* ---------- más buceo en la zona ---------- */
    .mas{padding:var(--s-16) 0;border-top:1px solid var(--ink)}
    .mas h2{font-size:clamp(28px,3.2vw,38px);margin-bottom:var(--s-6)}
    .mas-fila{display:grid;grid-template-columns:minmax(0,1fr) auto auto;gap:var(--s-6);align-items:baseline;padding:var(--s-4) 0;border-bottom:1px dotted var(--dots);min-height:56px}
    .mas-fila .nm{font-family:var(--rot);font-style:italic;font-size:clamp(22px,2.4vw,28px);line-height:1.15}
    .mas-fila .st{color:var(--ink-2)}
    .mas-fila svg{width:18px;height:18px;align-self:center}
    .mas-fila:hover .nm{color:var(--mag-ink)}

    /* ---------- cierre ---------- */
    .closer{background:var(--ink);color:var(--paper);padding:var(--s-16) 0}
    .closer .wrap{display:flex;align-items:flex-end;justify-content:space-between;gap:var(--s-8);flex-wrap:wrap}
    .closer .lt{max-width:52ch}
    .closer h2{font-size:clamp(30px,3.6vw,48px);line-height:1.1;margin:0 0 var(--s-3);color:var(--paper)}
    .closer p{margin:0;color:#d9dfd9;font-size:17px}
    .closer .btns{display:flex;flex-wrap:wrap;gap:var(--s-3)}
    .closer .btn{background:var(--paper);color:var(--ink);border-color:var(--paper)}
    .closer .btn:hover{background:var(--mag);border-color:var(--mag);color:#fff}
    .closer .btn.sec{background:transparent;color:var(--paper)}
    .closer .btn.sec:hover{background:var(--paper);color:var(--ink);border-color:var(--paper)}

    /* ---------- WhatsApp ---------- */
    .fab{position:fixed;right:20px;bottom:20px;z-index:80;display:inline-flex;align-items:center;gap:10px;background:var(--ink);color:var(--paper);border:1px solid var(--ink);padding:12px 18px 12px 14px;font-family:var(--lab);text-transform:uppercase;letter-spacing:.14em;font-size:11px;cursor:pointer;min-height:48px;transition:background var(--t-fast)}
    .fab:hover{background:var(--mag);border-color:var(--mag);color:#fff}
    .fab svg{width:20px;height:20px}

    @media (max-width:980px){
      .grid{grid-template-columns:1fr;gap:var(--s-13)}
      .rail{position:static;max-height:none;overflow:visible}
      .hoja-cols{grid-template-columns:1fr;gap:var(--s-6);align-items:start}
      .casillas{grid-template-columns:repeat(4,minmax(0,1fr))}
    }
    @media (max-width:680px){
      body{font-size:16.5px}
      .hoja{padding-top:var(--s-6)}
      .casillas{grid-template-columns:1fr 1fr}
      .casilla,.casilla:first-child{padding:var(--s-3) var(--s-3);border-left:0;border-bottom:1px solid var(--rule)}
      .casilla:nth-child(even){border-left:1px solid var(--rule-strong)}
      .casilla:nth-child(odd){padding-left:0}
      .casilla .v.txt{max-width:none}
      .hoja-btns .btn,.closer .btn{width:100%;justify-content:space-between}
      .closer .btns{width:100%}
      .datos-clave .dc-row{grid-template-columns:1fr;gap:2px}
      .mas-fila{grid-template-columns:minmax(0,1fr) auto}
      .mas-fila .st{display:none}
      .fab span{display:none}
      .fab{padding:12px;min-width:48px;justify-content:center}
      .foto figcaption{flex-wrap:wrap}
      .article table{display:block;overflow-x:auto}
    }
  </style>
<!-- Umami (analitica propia, sin cookies ni datos personales) -->
<script defer src="https://umami-scibasku.vercel.app/script.js" data-website-id="49faed99-e484-4618-8f78-e095cf9f421e"></script>
</head>
<body>

<Cabecera>
  <a slot="extra" class="btn sec lab cta-mini" id="ctaMini" href={cbUrl} target="_blank" rel="noopener" data-source="ficha-cta-mini-to-crucerobuceo">Ver fechas en crucerobuceo</a>
</Cabecera>

<header class="hoja">
  <div class="wrap">
    <div class="hoja-top lab">
      <span>Scubapedia</span><span>Ficha de buceo</span><span>{zona}</span>
    </div>
    <div class="hoja-cols">
      <div>
        <h1>{titleNombre}</h1>
        {ledeParts.length > 0 && (
          <p class="lede">{ledeParts.map((p, i) => <>{i > 0 && <span class="dot">·</span>}{p}</>)}</p>
        )}
        {d.giora_estuvo && <div class="giora-flag lab"><TrianguloGiora /> Buceado por Giora</div>}
      </div>
      {casillas.length > 0 && (
        <div class="casillas" role="list" aria-label="Datos clave">
          {casillas.map((c) => (
            <div class="casilla" role="listitem"><span class={`v${c.txt ? ' txt' : ''}`}>{c.v}</span><span class="k lab">{c.k}</span></div>
          ))}
        </div>
      )}
    </div>

    <figure class="foto">
      <div class="marco">
        {heroImg
          ? <img src={heroImg} alt={`Buceo en ${titleShort}`} fetchpriority="high" />
          : (
            <>
              <svg class="water" viewBox="0 0 1200 800" preserveAspectRatio="none" aria-hidden="true">
                <path d="M-10 -10 H1210 V196 C980 240, 640 152, 380 210 S60 268, -10 232 Z" fill="#d7e8e7"/>
                <path d="M-10 -10 H1210 V104 C1010 148, 660 68, 400 124 S60 176, -10 142 Z" fill="#c9dfe1"/>
                <path d="M-10 810 H1210 V600 C990 646, 650 566, 390 622 S60 678, -10 644 Z" fill="#e0eae6"/>
                <path d="M-10 810 H1210 V704 C1000 748, 660 672, 400 726 S60 780, -10 748 Z" fill="#d7e8e7"/>
                <g fill="none" stroke="#3c626e">
                  <path d="M-20 128 C180 96, 340 168, 520 138 S880 70, 1220 118" stroke-width=".9"/>
                  <path d="M-20 236 C200 202, 366 272, 540 238 S900 174, 1220 222" stroke-width=".55"/>
                  <path d="M-20 358 C220 326, 380 398, 560 358 S920 300, 1220 346" stroke-width=".9"/>
                  <path d="M-20 486 C206 452, 396 520, 578 482 S930 424, 1220 470" stroke-width=".55"/>
                  <path d="M-20 610 C232 578, 410 642, 592 604 S940 550, 1220 596" stroke-width=".9"/>
                  <path d="M-20 726 C216 696, 400 756, 584 720 S936 668, 1220 714" stroke-width=".55"/>
                </g>
              </svg>
              <span class="topo">{zona}</span>
            </>
          )}
      </div>
      {(heroImg || coords) && (
        <figcaption class="lab">
          <span>{heroImg ? `Buceo en ${titleShort}` : `Carta de ${zona}`}</span>
          {coords && <span class="num">{coords.lat}, {coords.lng}</span>}
        </figcaption>
      )}
    </figure>

    <div class="hoja-btns">
      <a class="btn" href="#pedir-presupuesto">Pedir presupuesto a medida</a>
      <a class="btn sec" href={cbUrl} target="_blank" rel="noopener" data-source="ficha-cta-to-crucerobuceo">Ver fechas en crucerobuceo</a>
    </div>
  </div>
</header>

<div class="body-section">
  <div class="wrap grid">
    <article class="article" data-pagefind-body>
      <slot />

      {datos.length > 0 && (
        <section class="datos-clave" id="datos-clave" aria-label={`Datos clave de buceo en ${titleNombre}`}>
          <h2>Datos clave</h2>
          <p class="dc-intro">Resumen estructurado de la ficha de {titleNombre}{d.pais && d.pais !== titleNombre ? ` (${d.pais})` : ''}, mantenido por Viajes Scibasku.</p>
          <dl>
            {datos.map((r) => (
              <div class="dc-row"><dt>{r.k}</dt><dd>{r.v}</dd></div>
            ))}
          </dl>
        </section>
      )}

      {Array.isArray(d.tags) && d.tags.length > 0 && (
        <ul class="tagrow">
          {d.tags.slice(0, 12).map((t: string) => <li><span>#{t}</span></li>)}
        </ul>
      )}

      <aside class="autor-box" aria-label="Autoría y revisión">
        <div class="ab-head lab">Sobre esta ficha</div>
        <p class="ab-body">
          Escrita y revisada por <strong>Giora Gilead Elenberg</strong>, agente de viajes especializado
          en buceo y fundador de <a href="https://viajesscibasku.com" target="_blank" rel="noopener">Viajes Scibasku</a>,
          agencia de viajes española con licencia <strong>CICMA 2283</strong>.
          {d.giora_estuvo && <span class="ab-estuvo"><TrianguloGiora /> Giora ha buceado en este destino.</span>}
        </p>
        {d.updated && <p class="ab-rev">Última revisión: {d.updated}</p>}
      </aside>
    </article>

    <aside class="rail" aria-label="Notas de margen">
      {rows.length > 0 && (
        <section class="nota">
          <h2 class="lab">Ficha técnica</h2>
          <div>
            {rows.map((r) => (
              <div class="row"><span class="k">{r.k}</span><span class={`v${r.hi ? ' hi' : ''}`}>{r.v}</span></div>
            ))}
          </div>
          <a class="btn sec" href={cbUrl} target="_blank" rel="noopener" data-source="ficha-rail-to-crucerobuceo">
            Ver fechas en crucerobuceo
            <svg class="arrow" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" set:html={arrow} />
          </a>
        </section>
      )}
      {fauna.length > 0 && (
        <section class="nota">
          <h2 class="lab">Registro de fauna</h2>
          <ul>
            {fauna.map((f) => <li set:html={inline(f)} />)}
          </ul>
        </section>
      )}
      {flota.length > 0 && (
        <section class="nota">
          <h2 class="lab">Flota que hace la ruta</h2>
          <div class="flota lab">
            {flotaMarcada.map((f) => <span class={f.propio ? 'propio' : undefined}>{f.n}</span>)}
          </div>
          {hayPropios && <p class="flota-nota">En magenta, los armadores con los que trabajamos directamente.</p>}
        </section>
      )}
      {h2.length > 0 && (
        <section class="nota">
          <h2 class="lab">En esta ficha</h2>
          <nav class="toc" id="toc" aria-label="En esta ficha">
            {h2.map((h) => (
              <a href={`#${h.slug}`}>{h.text}</a>
            ))}
          </nav>
        </section>
      )}
    </aside>
  </div>
</div>

{cercanas.length > 0 && (
  <section class="mas" id="relacionadas">
    <div class="wrap">
      <h2>Más buceo en {zona}</h2>
      {cercanas.map((c) => (
        <a class="mas-fila" href={`/destinos/${c.id}`}>
          <span class="nm">{c.title}</span>
          <span class="st lab">{c.cert}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" aria-hidden="true" set:html={arrow} />
        </a>
      ))}
    </div>
  </section>
)}

<section class="closer">
  <div class="wrap">
    <div class="lt">
      <h2>Bucea {titleShort} esta temporada</h2>
      <p>Comparamos liveaboards, fechas y logística para que decidas con cabeza. Agencia CICMA 2283, sin sorpresas.</p>
    </div>
    <div class="btns">
      <a class="btn" href="#pedir-presupuesto">Pedir presupuesto a medida</a>
      <a class="btn sec" href={cbUrl} target="_blank" rel="noopener" data-source="ficha-closer-to-crucerobuceo">Ver fechas en crucerobuceo</a>
    </div>
  </div>
</section>

<CaptacionForm destino={titleNombre} source="ficha" />

<Pie />

<a class="fab" href={WA} target="_blank" rel="noopener" aria-label="Escribir a Giora por WhatsApp">
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm5.8 14.13c-.25.69-1.45 1.32-1.99 1.4-.53.08-1.02.29-3.43-.71-2.89-1.2-4.73-4.16-4.87-4.35-.14-.19-1.16-1.54-1.16-2.94 0-1.4.73-2.08.99-2.37.25-.28.55-.35.73-.35.18 0 .37 0 .53.01.17.01.4-.06.62.48.25.6.85 2.07.92 2.22.07.15.12.32.02.51-.09.19-.14.31-.28.48-.14.17-.29.37-.42.5-.14.14-.28.29-.12.57.16.28.71 1.17 1.53 1.9 1.05.94 1.94 1.23 2.21 1.37.28.14.44.12.6-.07.16-.19.69-.81.87-1.08.18-.28.37-.23.62-.14.25.09 1.6.76 1.87.9.28.14.46.21.53.32.07.12.07.66-.18 1.35Z"/></svg>
  <span>Pregúntale a Giora</span>
</a>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />

<script is:inline>
  (function () {
    var ctaMini = document.getElementById('ctaMini');
    var hoja = document.querySelector('.hoja');
    if (ctaMini && hoja) {
      var tick = function () { ctaMini.classList.toggle('show', window.scrollY > (hoja.offsetHeight - 120)); };
      window.addEventListener('scroll', tick, { passive: true });
      tick();
    }
    var tocLinks = Array.prototype.slice.call(document.querySelectorAll('#toc a'));
    var sections = tocLinks.map(function (a) { return document.querySelector(a.getAttribute('href')); }).filter(Boolean);
    if (sections.length && 'IntersectionObserver' in window) {
      var spy = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) {
            var id = '#' + e.target.id;
            tocLinks.forEach(function (a) { a.classList.toggle('active', a.getAttribute('href') === id); });
          }
        });
      }, { rootMargin: '-30% 0px -60% 0px' });
      sections.forEach(function (s) { spy.observe(s); });
    }
  })();
</script>

</body>
</html>
