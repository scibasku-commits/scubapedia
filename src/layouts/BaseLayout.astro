---
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import '../styles/global.css';
import '../styles/carta.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title = 'Scuba-pedia', description = 'La enciclopedia de destinos de buceo del mundo, curada por Viajes Scibasku.', noindex = false } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — Scuba-pedia by Scibasku</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Scuba-pedia",
    "url": "https://www.scubapedia.org",
    "description": "La enciclopedia de destinos de buceo del mundo",
    "publisher": {
      "@type": "Organization",
      "name": "Viajes Scibasku",
      "url": "https://viajesscibasku.com"
    }
  })} />
  <!-- Google Analytics (GA4) -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-LHZYGMPX6K"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-LHZYGMPX6K');
  </script>
<!-- Umami (analitica propia, sin cookies ni datos personales) -->
<script defer src="https://umami-scibasku.vercel.app/script.js" data-website-id="49faed99-e484-4618-8f78-e095cf9f421e"></script>
<style is:global>
  html,body{overflow-x:clip}
  /* páginas legales y de gracias: una sola hoja de estilo, con los tokens de la carta */
  .lg-wrap{max-width:820px;margin:0 auto;padding:var(--s-13) var(--s-6) var(--s-20);line-height:1.7;color:var(--ink);font-size:17px}
  .lg-wrap h1{font-style:italic;font-size:clamp(34px,5vw,52px);margin:0 0 var(--s-2);line-height:1.1;letter-spacing:0}
  .lg-wrap .lg-sub{color:var(--ink-2);font-size:16px;margin:0 0 var(--s-8);padding-bottom:var(--s-6);border-bottom:1px solid var(--ink)}
  .lg-wrap h2{font-size:clamp(22px,2.8vw,28px);margin:var(--s-10) 0 var(--s-3);padding-top:var(--s-3);border-top:1px solid var(--rule-strong);line-height:1.2}
  .lg-wrap h3{font-style:italic;font-size:20px;margin:var(--s-6) 0 var(--s-2)}
  .lg-wrap p{margin:0 0 var(--s-3)}
  .lg-wrap ul{margin:0 0 var(--s-4);padding-left:22px}
  .lg-wrap li{margin:0 0 var(--s-2)}
  .lg-wrap strong{font-weight:600}
  .lg-wrap .lg-a,.lg-wrap p a,.lg-wrap li a{color:var(--ink);text-decoration:underline;text-underline-offset:3px;text-decoration-color:var(--rule-strong)}
  .lg-wrap .lg-a:hover,.lg-wrap p a:hover,.lg-wrap li a:hover{color:var(--mag-ink);text-decoration-color:var(--mag)}
  .lg-wrap .lg-pend{border:1px solid var(--mag);background:var(--white);padding:12px 14px;margin:0 0 var(--s-4)}
  .lg-wrap .lg-tw{overflow-x:auto;margin:0 0 var(--s-5)}
  .lg-wrap .lg-t{width:100%;border-collapse:collapse;font-size:15px;border:1px solid var(--ink)}
  .lg-wrap .lg-t th{text-align:left;padding:8px;background:var(--paper-2);color:var(--ink);font-weight:500;border-bottom:1px solid var(--ink)}
  .lg-wrap .lg-t td{padding:8px;border-bottom:1px dotted var(--dots);vertical-align:top}
  .lg-wrap .lg-t code{font-family:inherit;font-size:14px}
  .lg-wrap .lg-hr{border:0;border-top:1px solid var(--rule-strong);margin:var(--s-10) 0 var(--s-5)}
  .lg-wrap .lg-foot{font-size:15px;color:var(--ink-2)}
  .lg-back{display:inline-block;margin-bottom:var(--s-6);font-size:15px;color:var(--ink)}
  /* gracias */
  .gr-wrap{max-width:640px;margin:0 auto;padding:var(--s-16) var(--s-6);text-align:left}
  .gr-ok{width:56px;height:56px;border:1px solid var(--mag);color:var(--mag-ink);display:flex;align-items:center;justify-content:center;font-size:1.8rem;margin:0 0 var(--s-6)}
  .gr-wrap h1{font-style:italic;font-size:clamp(34px,5vw,52px);margin:0 0 var(--s-4);letter-spacing:0}
  .gr-wrap p{line-height:1.65;margin:0 0 var(--s-4);font-size:19px}
  .gr-a{text-decoration:underline;text-underline-offset:3px;color:var(--ink)}
  .gr-wrap .btn{text-decoration:none;margin-top:var(--s-2)}
</style>
</head>
<body>

  <Cabecera />

  <main>
    <slot />
  </main>

  <Pie />

</body>
</html>
